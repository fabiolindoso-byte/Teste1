# Token do bot Discord (obtenha em https://discord.com/developers/applications)
DISCORD_TOKEN=seu_token_aqui

# Chave da API da Anthropic (obtenha em https://console.anthropic.com)
ANTHROPIC_API_KEY=sua_chave_aqui

# Seu nome de exibição no Discord (como aparece nos servidores)
# Usado pelo !pendencias e !briefing para identificar o que é pendente para você
MY_DISCORD_NAME=SeuNomeAqui

# Seu ID numérico no Discord (opcional, complementa o nome)
# Para descobrir: Configurações > Avançado > Modo desenvolvedor, depois clique com botão direito no seu perfil
MY_DISCORD_ID=

# Canais que o !briefing, !pendencias e !parados devem escanear (IDs separados por vírgula)
# Para descobrir o ID: botão direito no canal > Copiar ID (com modo desenvolvedor ativo)
MONITORED_CHANNELS=111111111,222222222,333333333

# Canais onde o bot responde a TODAS as mensagens (sem precisar mencionar)
# Deixe vazio para responder apenas quando mencionado
ALLOWED_CHANNEL_IDS=

# Prefixo dos comandos
COMMAND_PREFIX=!

# Persona do bot nas conversas diretas
SYSTEM_PROMPT=Você é um assistente útil integrado ao Discord. Responda de forma clara e concisa.
